{
  "name": "@enterspeed/js-schema-types",
  "version": "1.2.2-beta.1",
  "description": "Strongly typed types for Enterspeed JavaScript schemas.",
  "main": "src/index.ts",
  "watch": {
    "publish-locally": {
      "patterns": [
        "src"
      ],
      "extensions": "ts",
      "quiet": false
    }
  },
  "scripts": {
    "publish": "dts-bundle-generator --config dts-bundle-generator.config.json src/index.d.ts && npm publish --access public",
    "publish-preview": "dts-bundle-generator --config dts-bundle-generator.config.json src/index.d.ts && npm publish --access public --tag beta",
    "publish-locally": "dts-bundle-generator --config dts-bundle-generator.config.json src/index.d.ts && local-package-publisher -p",
    "watch": "npm-watch publish-locally"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enterspeedhq/enterspeed-js-schema-types.git"
  },
  "keywords": [
    "enterspeed",
    "schema",
    "javascript",
    "intellisense"
  ],
  "files": [
    "./dist/index.d.ts"
  ],
  "typings": "./dist/index.d.ts",
  "author": "Enterspeed",
  "license": "MIT",
  "homepage": "https://github.com/enterspeedhq/enterspeed-js-schema-types",
  "devDependencies": {
    "dts-bundle-generator": "^8.0.1",
    "local-package-publisher": "^1.0.5",
    "npm-watch": "^0.11.0"
  }
}
